# GEMINI_API_KEY: Required for Gemini AI features (if used).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="https://your-app.run.app"

# GOOGLE_CLIENT_ID: Your Google Cloud OAuth 2.0 Client ID for Drive integration
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: Your Google Cloud OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET="your-client-secret"

# GOOGLE_REDIRECT_URI: OAuth callback URI (e.g., https://your-app.run.app/auth/callback)
GOOGLE_REDIRECT_URI="https://your-app.run.app/auth/callback"

# SESSION_SECRET: Secret used to sign session tokens
SESSION_SECRET="your-random-32-character-session-secret"
